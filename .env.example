# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# The assistant route is the only thing on this site that needs a secret.
# In production this is set in the Vercel dashboard (Project → Settings →
# Environment Variables), NOT in any file in this repository.
GROQ_API_KEY=

# Optional. Model names are configuration because providers retire them.
# GROQ_ANSWER_MODEL=openai/gpt-oss-120b
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
